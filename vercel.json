{
    "version": 2,
    "name": "task-management",
    "builds": [
        {
            "src": "packages/server/build/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "packages/server/build/index.js"
        }
    ],
    "installCommand": "npm install && npm run bootstrap",
    "buildCommand": "npm run build"
}