{
  "name": "Neiv",
  "private": true,
  "scripts": {
    "watch": "lerna run --scope=server watch --stream",
    "start": "lerna run --scope=server start --stream",
    "build": "lerna run --scope=server build --stream",
    "prod": "npm start",
    "bootstrap": "npx lerna bootstrap && lerna init",
    "make-migration": "lerna run --scope=@neiv/db make-migration -- --",
    "make-seed": "lerna run --scope=@neiv/db make-seed -- --",
    "seed": "knex seed:run --env=development --knexfile=./modules/database/knexfile.js --specific=001_user.js",
    "run-seed": "lerna run --scope=@neiv/db run-seed",
    "migrate": "lerna run --scope=@neiv/db migrate",
    "rollback": "lerna run --scope=@neiv/db rollback",
    "clear-db": "lerna run --scope=@neiv/db clear-db",
    "lint-fix": "eslint . --fix --ext .ts",
    "setup-keys": "husky install && lerna run --scope=@neiv/tokens prepare"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.514.0",
    "@aws-sdk/s3-request-presigner": "^3.514.0",
    "@faker-js/faker": "^8.3.1",
    "aws-sdk": "^2.1559.0",
    "dotenv": "^10.0.0",
    "joi": "^17.5.0",
    "lodash": "^4.17.21",
    "manifest-library": "^1.0.0",
    "minio": "^7.1.3",
    "node-cron": "^3.0.3",
    "slack-notify": "^2.0.6",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@babel/eslint-parser": "^7.22.10",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.22.10",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-destructuring": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-typescript": "^7.22.5",
    "@babel/runtime": "^7.22.10",
    "@types/bluebird": "^3.5.38",
    "@types/date-fns": "^2.6.0",
    "@types/express": "^4.17.17",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "eslint": "^8.6.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "husky": "^7.0.4",
    "lerna": "^3.22.1",
    "node-hmr-plugin": "^1.0.1",
    "prettier": "^3.1.0",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-node-externals": "^3.0.0"
  },
  "workspaces": [
    "packages/*",
    "modules/*"
  ],
  "engines": {
    "node": "v18.16.*"
  }
}
