{
    "env": {
        "node": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:prettier/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "plugins": [
        "@typescript-eslint"
    ],
    "rules": {
        "linebreak-style": [
            "error",
            "unix"
        ],
        "quotes": [
            "error",
            "single"
        ],
        "semi": [
            "error",
            "always"
        ],
        "no-console": "error",
        "no-nested-ternary": "error",
        "camelcase": [
            "error",
            {
                "ignoreDestructuring": true,
                "properties": "never",
                "ignoreGlobals": true
            }
        ],
        "prefer-const": [
            "error",
            {
                "destructuring": "any",
                "ignoreReadBeforeAssign": false
            }
        ],
        "no-use-before-define": "error",
        "object-curly-spacing": [
            "error",
            "always"
        ],
        "max-depth": [
            "error",
            4
        ],
        "comma-dangle": [
            "error",
            "never"
        ],
        "prettier/prettier": [
            "error",
            {
              "printWidth": 120,
              "singleQuote": true,
              "trailingComma": "none",
              "arrowParens": "avoid",
              "bracketSpacing": true
            }
          ]
    }
}